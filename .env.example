# ZeroMQ transport
ZMQ_BIND_HOST=0.0.0.0
ZMQ_PUB_PORT=5575
ZMQ_REP_PORT=5576
ZMQ_PUBLISH_QUEUE_SIZE=100000

# Logging
LOG_LEVEL=INFO
LOG_BACKUP_COUNT=30
LOG_DIR=logs

# TAP credentials and endpoints.
# Shared TAP_HOST/TAP_PORT/TAP_USER_ID/TAP_PASSWORD/TAP_AUTH_CODE values may
# also be used as fallbacks for both MD and TD.
TAP_MD_HOST=
TAP_MD_PORT=0
TAP_MD_USER_ID=
TAP_MD_PASSWORD=
TAP_MD_AUTH_CODE=
TAP_TD_HOST=
TAP_TD_PORT=0
TAP_TD_USER_ID=
TAP_TD_PASSWORD=
TAP_TD_AUTH_CODE=
TAP_CLIENT_ID=
TAP_CLIENT_LOCATION=CN

# Canonical symbols: ExchangeNo:CommodityType:CommodityNo:ContractNo
TAP_SYMBOLS=COMEX:F:GC:2608

# Runtime and resilience
TAP_DATA_PATH=flow/tap
TAP_TIMEZONE=Asia/Shanghai
TAP_CONNECT_TIMEOUT_SECONDS=20
TAP_QUERY_TIMEOUT_SECONDS=10
TAP_RECONNECT_MAX_ATTEMPTS=5
TAP_RECONNECT_INITIAL_DELAY_SECONDS=2
TAP_RECONNECT_MAX_DELAY_SECONDS=60
